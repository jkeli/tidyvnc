<Project>
  <!-- Shared settings for the Windows (.NET/WinUI) projects under apps/windows,
       platform/windows and tests/windows (plans/native-ui-winui PLAN.md
       sections 3-4). No other part of the repository uses MSBuild. -->
  <PropertyGroup>
    <RepoRoot>$([MSBuild]::EnsureTrailingSlash('$(MSBuildThisFileDirectory)'))</RepoRoot>
    <!-- One version source: CMakeLists.txt's VERSION (PACKAGING.md section 2). -->
    <TidyVncVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(RepoRoot)CMakeLists.txt')), 'set\(VERSION ([0-9.]+)\)').Groups[1].Value)</TidyVncVersion>
    <Version>$(TidyVncVersion)</Version>
    <AssemblyVersion>$(TidyVncVersion).0</AssemblyVersion>
    <FileVersion>$(TidyVncVersion).0</FileVersion>
    <Company>TidyVNC contributors</Company>
    <Product>TidyVNC</Product>
    <Copyright>Copyright TidyVNC contributors. Licensed under GPL-2.0-or-later.</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- Windows 11 only (DECISIONS.md D6); x64 and ARM64. -->
    <TidyVncTargetFramework>net10.0-windows10.0.26100.0</TidyVncTargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
