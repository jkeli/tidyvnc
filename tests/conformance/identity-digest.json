{
  "format": "tidyvnc-conformance-v1",
  "module": "IdentityDigest",
  "about": [
    "Shared cases for the core (tests/unit/identitydigest.cxx) and the macOS",
    "Swift identities (NativeCredentialKey, NativeTrustScope, NativeSSHGateway,",
    "NativeSSHResolvedGateway). 'expect' values were computed independently",
    "(the macOS goldens, or Python from the documented field encoding);",
    "'sameAs'/'differsFrom' name another case. Defaults: route '',",
    "allowUnixSockets true, username '', alias '', port 22."
  ],
  "cases": [
    {"name": "credential.golden", "kind": "credential", "endpoint": "HOST:1", "securityType": 2, "shape": "passwordOnly",
     "expect": "v1:30f12c29b75ce9cc7cfd537abe1c50eac5b2ddab0111ed4eefbe363441745ca2"},
    {"name": "credential.port-spelling", "kind": "credential", "endpoint": "host::5901", "securityType": 2, "shape": "passwordOnly", "sameAs": "credential.golden"},
    {"name": "credential.whitespace-and-sign", "kind": "credential", "endpoint": " host: +001 ", "securityType": 2, "shape": "passwordOnly", "sameAs": "credential.golden"},
    {"name": "credential.bracketed-name", "kind": "credential", "endpoint": "[Host]:1", "securityType": 2, "shape": "passwordOnly", "sameAs": "credential.golden"},
    {"name": "credential.empty-is-localhost-0", "kind": "credential", "endpoint": "", "securityType": 2, "shape": "passwordOnly"},
    {"name": "credential.localhost-0", "kind": "credential", "endpoint": "localhost:0", "securityType": 2, "shape": "passwordOnly", "sameAs": "credential.empty-is-localhost-0"},
    {"name": "credential.ipv6-long", "kind": "credential", "endpoint": "[2001:0DB8:0:0:0:0:0:1]:1", "securityType": 2, "shape": "passwordOnly"},
    {"name": "credential.ipv6-short", "kind": "credential", "endpoint": "[2001:db8::1]::5901", "securityType": 2, "shape": "passwordOnly", "sameAs": "credential.ipv6-long"},
    {"name": "credential.other-display", "kind": "credential", "endpoint": "host:2", "securityType": 2, "shape": "passwordOnly", "differsFrom": "credential.golden"},
    {"name": "credential.trailing-dot", "kind": "credential", "endpoint": "host.:1", "securityType": 2, "shape": "passwordOnly", "differsFrom": "credential.golden"},
    {"name": "credential.alias", "kind": "credential", "endpoint": "alias:1", "securityType": 2, "shape": "passwordOnly", "differsFrom": "credential.golden"},
    {"name": "credential.loopback-name", "kind": "credential", "endpoint": "localhost:1", "securityType": 2, "shape": "passwordOnly"},
    {"name": "credential.loopback-address", "kind": "credential", "endpoint": "127.0.0.1:1", "securityType": 2, "shape": "passwordOnly", "differsFrom": "credential.loopback-name"},
    {"name": "credential.mapped-ipv4", "kind": "credential", "endpoint": "[::ffff:127.0.0.1]:1", "securityType": 2, "shape": "passwordOnly", "differsFrom": "credential.loopback-address"},
    {"name": "credential.scope-lower", "kind": "credential", "endpoint": "[fe80::1%en0]:1", "securityType": 2, "shape": "passwordOnly"},
    {"name": "credential.scope-upper", "kind": "credential", "endpoint": "[fe80::1%EN0]:1", "securityType": 2, "shape": "passwordOnly", "differsFrom": "credential.scope-lower"},
    {"name": "credential.scope-number", "kind": "credential", "endpoint": "[fe80::1%1]:1", "securityType": 2, "shape": "passwordOnly"},
    {"name": "credential.scope-leading-zero", "kind": "credential", "endpoint": "[fe80::1%01]:1", "securityType": 2, "shape": "passwordOnly", "differsFrom": "credential.scope-number"},
    {"name": "credential.socket-case", "kind": "credential", "endpoint": "/tmp/Desktop", "securityType": 2, "shape": "passwordOnly"},
    {"name": "credential.socket-lower", "kind": "credential", "endpoint": "/tmp/desktop", "securityType": 2, "shape": "passwordOnly", "differsFrom": "credential.socket-case"},
    {"name": "credential.socket", "kind": "credential", "endpoint": "/tmp/socket", "securityType": 2, "shape": "passwordOnly"},
    {"name": "credential.socket-spaces", "kind": "credential", "endpoint": " /tmp/socket ", "securityType": 2, "shape": "passwordOnly", "differsFrom": "credential.socket"},
    {"name": "credential.socket-relative", "kind": "credential", "endpoint": "./socket", "securityType": 2, "shape": "passwordOnly", "differsFrom": "credential.socket"},
    {"name": "credential.socket-dotdot", "kind": "credential", "endpoint": "/tmp/a/../socket", "securityType": 2, "shape": "passwordOnly", "differsFrom": "credential.socket"},
    {"name": "credential.routed", "kind": "credential", "endpoint": "HOST:1", "route": "ssh-v1:route", "securityType": 2, "shape": "passwordOnly",
