    {"name": "credential.error.password-with-user", "kind": "credential", "endpoint": "HOST:1", "securityType": 2, "shape": "passwordOnly", "username": "alice", "error": "unexpectedUsername"},
    {"name": "credential.error.none", "kind": "credential", "endpoint": "HOST:1", "securityType": 1, "shape": "passwordOnly", "error": "invalidAuthentication"},
    {"name": "credential.error.invalid", "kind": "credential", "endpoint": "HOST:1", "securityType": 0, "shape": "passwordOnly", "error": "invalidAuthentication"},
    {"name": "credential.error.tls-wrapper", "kind": "credential", "endpoint": "HOST:1", "securityType": 18, "shape": "passwordOnly", "error": "invalidAuthentication"},
    {"name": "credential.error.vencrypt-wrapper", "kind": "credential", "endpoint": "HOST:1", "securityType": 19, "shape": "passwordOnly", "error": "invalidAuthentication"},
    {"name": "credential.error.ra2-wrapper", "kind": "credential", "endpoint": "HOST:1", "securityType": 257, "shape": "usernamePassword", "username": "a", "error": "invalidAuthentication"},
    {"name": "credential.error.ra2ne-wrapper", "kind": "credential", "endpoint": "HOST:1", "securityType": 260, "shape": "usernamePassword", "username": "a", "error": "invalidAuthentication"},
    {"name": "credential.error.too-long", "kind": "credential", "endpoint": {"repeat": "a", "count": 4097}, "securityType": 2, "shape": "passwordOnly", "error": "tooLong"},
    {"name": "credential.error.nul", "kind": "credential", "endpoint": "host\u0000:1", "securityType": 2, "shape": "passwordOnly", "error": "invalidText"},
    {"name": "credential.error.endpoint", "kind": "credential", "endpoint": "host:99999", "securityType": 2, "shape": "passwordOnly", "error": "invalidEndpoint"},
    {"name": "credential.error.unix-disallowed", "kind": "credential", "endpoint": "/tmp/socket", "allowUnixSockets": false, "securityType": 2, "shape": "passwordOnly", "error": "invalidEndpoint"},

    {"name": "trust.certificate.golden", "kind": "trustCertificate", "endpoint": "HOST:1",
     "expect": "v1:c0f8fafc6b5249a1e7119d3a3594523a5947e50d04d78ec64be2ec1192f0d047"},
    {"name": "trust.certificate.spelling", "kind": "trustCertificate", "endpoint": "host::5901", "sameAs": "trust.certificate.golden"},
    {"name": "trust.host-key.golden", "kind": "trustHostKey", "endpoint": "HOST:1",
