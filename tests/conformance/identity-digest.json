    {"name": "trust.host-key.spelling", "kind": "trustHostKey", "endpoint": "host::5901", "sameAs": "trust.host-key.golden"},
    {"name": "trust.certificate.routed", "kind": "trustCertificate", "endpoint": "HOST:1", "route": "ssh-route",
     "expect": "v1:fe6a644246bd044da336e9594bdcbac686fab962316b8e597a1aa57abd337c2b"},
    {"name": "trust.certificate.other-port", "kind": "trustCertificate", "endpoint": "host:2", "differsFrom": "trust.certificate.golden"},
    {"name": "trust.certificate.socket", "kind": "trustCertificate", "endpoint": "/tmp/vnc", "differsFrom": "trust.certificate.golden"},
    {"name": "trust.certificate.scope-en0", "kind": "trustCertificate", "endpoint": "[fe80::1%en0]:1"},
    {"name": "trust.certificate.scope-en1", "kind": "trustCertificate", "endpoint": "[fe80::1%en1]:1", "differsFrom": "trust.certificate.scope-en0"},
    {"name": "trust.certificate.path-precomposed", "kind": "trustCertificate", "endpoint": "/tmp/Café"},
    {"name": "trust.certificate.path-decomposed", "kind": "trustCertificate", "endpoint": "/tmp/Café", "differsFrom": "trust.certificate.path-precomposed"},
    {"name": "trust.certificate.route-upper", "kind": "trustCertificate", "endpoint": "HOST:1", "route": "A"},
    {"name": "trust.certificate.route-lower", "kind": "trustCertificate", "endpoint": "HOST:1", "route": "a", "differsFrom": "trust.certificate.route-upper"},
    {"name": "trust.error.empty", "kind": "trustCertificate", "endpoint": "", "error": "invalidEndpoint"},
    {"name": "trust.error.nul-route", "kind": "trustHostKey", "endpoint": "HOST:1", "route": "a\u0000b", "error": "invalidText"},

    {"name": "ssh.route.alice", "kind": "sshRoute", "gateway": "alice@GATEWAY.invalid",
