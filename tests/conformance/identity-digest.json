    {"name": "ssh.resolved.alias", "kind": "sshResolved", "host": "gateway.invalid", "username": "alice", "port": 2222, "alias": "known.alias",
     "expect": "ssh-v2:88b69a23294150bdc7f6557f0518721c25d2767e9e437f8cb4e69b161860c751"},
    {"name": "ssh.resolved.error.alias", "kind": "sshResolved", "host": "gateway.invalid", "username": "alice", "port": 22, "alias": "bad alias", "error": "invalidAlias"},
    {"name": "ssh.resolved.error.no-user", "kind": "sshResolved", "host": "gateway.invalid", "username": "", "port": 22, "error": "invalidGateway"},
