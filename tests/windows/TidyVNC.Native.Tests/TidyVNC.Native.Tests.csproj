<Project Sdk="Microsoft.NET.Sdk">
  <!-- MSTest suite for TidyVNC.Native (plans/native-ui-winui TESTING.md
       section 1: Interop and Library layers). Runs against the core build
       selected by TidyVncNativeBin (default build/winui/x64-debug/bin). -->
  <PropertyGroup>
    <TargetFramework>$(TidyVncTargetFramework)</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1062;CA2007;CA1031;CA1849;CA2000;CA5394;CA1861;CA1812;CA1001;CA1063;CA1816;CA1822;MSTEST0037</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The askpass helper that ssh.exe starts in the tunnel tests. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TidyVncAskpass</_Parameter1>
      <_Parameter2>$(RepoRoot)apps\windows\TidyVNC.SshAskpass\bin\$(Platform)\$(Configuration)\$(TidyVncTargetFramework)\win-$(Platform.ToLowerInvariant())\tidyvnc-ssh-askpass.exe</_Parameter2>
    </AssemblyAttribute>
    <!-- The generated Windows string catalog, checked against the keys models produce. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TidyVncStrings</_Parameter1>
      <_Parameter2>$(RepoRoot)apps\windows\TidyVNC\Strings\en-US\Resources.resw</_Parameter2>
    </AssemblyAttribute>
    <!-- The shared conformance corpus (tests/conformance), read in place. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TidyVncConformance</_Parameter1>
      <_Parameter2>$(RepoRoot)tests\conformance</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\RfbTestServer.cs" Link="RfbTestServer.cs" />
    <Compile Include="..\Shared\SshTestServer.cs" Link="SshTestServer.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\platform\windows\TidyVNC.Native\TidyVNC.Native.csproj" />
    <!-- tidyvnc-ssh-askpass.exe is started by ssh.exe in the tunnel tests. -->
    <ProjectReference Include="..\..\..\apps\windows\TidyVNC.SshAskpass\TidyVNC.SshAskpass.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(TidyVncNativeBin)\tidyvnc-abi-layout.exe" CopyToOutputDirectory="PreserveNewest" Visible="false"
          Link="tidyvnc-abi-layout.exe" Condition="Exists('$(TidyVncNativeBin)\tidyvnc-abi-layout.exe')" />
  </ItemGroup>
</Project>
