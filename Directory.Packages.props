<Project>
  <!-- Central, pinned package versions (PLAN.md section 4). Adding a package
       also needs its licence text under apps/windows/ThirdParty (W7.2). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Windows App SDK: the 2.x line, pinned at 2.5.1 (DECISIONS.md D24). -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!-- Components of that metapackage the viewer does not use; referenced only to exclude their
         assets (the AI and ML runtimes, search and widgets; W0.2/W7.1). Without the Runtime
         package's framework MSIX, self-contained builds assemble the payload and WinRT
         registrations from the components actually referenced. Versions are the ones the
         metapackage resolves to. Since 2.0 the ML runtime is its own package, which would
         otherwise arrive transitively through the ML component. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.AI" Version="2.5.5" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.ML" Version="2.1.94" />
    <PackageVersion Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.74" />
    <PackageVersion Include="System.Numerics.Tensors" Version="9.0.0" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Search" Version="2.5.5" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Widgets" Version="2.0.5" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.335" />
    <PackageVersion Include="MSTest" Version="4.4.1" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageVersion Include="Axe.Windows" Version="2.4.2" />
  </ItemGroup>
</Project>
