<Project Sdk="Microsoft.NET.Sdk">
  <!-- vncviewer.exe, the console launcher (plans/native-ui-winui DECISIONS.md
       D9): validates the command line with the core parser, prints help,
       version and syntax errors with the retained exit codes, then runs
       TidyVNC.exe beside it with the same arguments and waits for it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(TidyVncTargetFramework)</TargetFramework>
    <AssemblyName>vncviewer</AssemblyName>
    <RootNamespace>TidyVNC.Cli</RootNamespace>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <ApplicationManifest>..\TidyVNC\app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);CA1303</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)platform\windows\TidyVNC.Native\TidyVNC.Native.csproj" />
  </ItemGroup>
</Project>
