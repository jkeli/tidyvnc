<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TidyVNC.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Tones for code-built text and surfaces (Ui.SetTone, Ui.Surface). ThemeResource setters follow
                 light, dark and each contrast theme while windows are open (UX.md section 10). -->
            <Style x:Key="TidyBodyTextNormal" TargetType="TextBlock" />
            <Style x:Key="TidyBodyTextPrimary" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="TidyBodyTextSecondary" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="TidyBodyTextWarning" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="TidyBodyTextError" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="TidyCaptionTextNormal" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}" />
            <Style x:Key="TidyCaptionTextPrimary" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="TidyCaptionTextSecondary" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="TidyCaptionTextWarning" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="TidyCaptionTextError" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <Style x:Key="TidyBarSurface" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="TidyOverlaySurface" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="TidyDivider" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="TidyDisplayTileChosen" TargetType="Grid">
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="TidyDisplayTile" TargetType="Grid">
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
