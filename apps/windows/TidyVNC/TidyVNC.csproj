<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WinUI 3 viewer (plans/native-ui-winui PLAN.md section 3). Unpackaged
       and self-contained (DECISIONS.md D4): the .NET runtime and the Windows App
       SDK runtime travel with the app; FLTK is never linked. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(TidyVncTargetFramework)</TargetFramework>
    <RootNamespace>TidyVNC</RootNamespace>
    <AssemblyName>TidyVNC</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Unpackaged publishing only carries the app's PRI (strings and compiled XAML) with the MSIX tooling on. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(RepoRoot)media\icons\tidyvnc.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <!-- XAML event handlers and generated code follow WinUI conventions. -->
    <NoWarn>$(NoWarn);CA1812;CA1001;CA1515;CA2213</NoWarn>
    <!-- Program.cs owns Main: primary-instance redirection happens before XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <!-- Not used: Windows AI APIs, ONNX Runtime/DirectML and widgets stay out of the payload. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)platform\windows\TidyVNC.Native\TidyVNC.Native.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <!-- The qps-ploc/qps-plocm layout-check catalogs (`strings.py pseudo`) never ship. -->
    <PRIResource Remove="Strings\qps-*\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Window and title bar icons, loaded from the app folder. -->
    <Content Include="$(RepoRoot)media\icons\tidyvnc_32.png" Link="Assets\tidyvnc_32.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)media\icons\tidyvnc.ico" Link="Assets\tidyvnc.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Help (H02): the licence, acknowledgements and third-party notices ship with the app. -->
    <Content Include="$(RepoRoot)LICENCE.TXT" Link="Documents\LICENCE.TXT" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)README.rst" Link="Documents\README.rst" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)apps\windows\ThirdParty\README.md" Link="Documents\ThirdParty.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
