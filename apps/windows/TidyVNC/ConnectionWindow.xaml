<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TidyVNC.ConnectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TidyVNC">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Address" PlaceholderText="VNC server (host:display or host::port)"
                     AutomationProperties.Name="VNC server" AutomationProperties.AutomationId="connection.endpoint" KeyDown="AddressKeyDown" />
            <Button x:Name="ConnectButton" Grid.Column="1" Content="Connect" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="connection.connect"
                    Click="ConnectClick" />
            <Button x:Name="DisconnectButton" Grid.Column="2" Content="Disconnect" IsEnabled="False" Click="DisconnectClick" AutomationProperties.AutomationId="connection.disconnect" />
            <Button x:Name="NewWindowButton" Grid.Column="3" Content="New window" Click="NewWindowClick" AutomationProperties.AutomationId="connection.newWindow" />
        </Grid>
        <Grid Grid.Row="1">
            <Border x:Name="DesktopHost" Background="Black" />
            <TextBlock x:Name="Status" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="White" TextWrapping="Wrap" MaxWidth="480" TextAlignment="Center"
                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="connection.status" />
        </Grid>
    </Grid>
</Window>
