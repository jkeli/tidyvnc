    },
    "invocation.help.syntax": {
      "comment": "Native launch presentation. Preserve technical names and format placeholders; arguments are literal command syntax or display values.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names are case-insensitive. Enable a boolean with %@; disable it with\n%@. Values accept %@, %@, %@ or %@.\nUse %@ before a relative file name; a bare name is a server address.\nExplicit files override CLI settings and open for review before connecting.\nWith no server address, a connection form opens. Native defaults use native\nstores; importing compatibility defaults/history is a separate explicit action."
          }
        }
      }
    },
    "invocation.help.parameters": {
      "comment": "Native launch presentation. Preserve technical names and format placeholders; arguments are literal command syntax or display values.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parameters (* requires a native adapter; unavailable entries cannot be used):"
          }
        }
      }
    },
