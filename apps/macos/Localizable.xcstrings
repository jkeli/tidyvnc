    "connection.issue.networkPolicy.message": {
      "comment": "Redacted structured connection diagnostic. Do not add server-provided details, addresses or credentials.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network or system policy may be preventing this connection. Check firewall and VPN settings. For a local server, also check TidyVNC under System Settings > Privacy & Security > Local Network. This error does not identify which policy blocked access."
          }
        }
      }
    },
    "connection.issue.connectionTimeout.message": {
