    "invocation.help.logging": {
      "comment": "Native launch presentation. Preserve technical names and format placeholders; arguments are literal command syntax or display values.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nLog targets: %@, or empty to disable.\nFile: %@, created on first output with one %@; failures use %@.\n"
          }
        }
      }
    },
    "invocation.help.listen": {
      "comment": "Native launch presentation. Preserve technical names and format placeholders; arguments are literal command syntax or display values.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen defaults to TCP port 5500; port 0 chooses an available port. Use a decimal port from 0 to 65535.\nWith %@, review file settings before binding; %@ supplies the port. Unix socket listeners are unsupported.\nAccept each incoming connection in the listener window.\n"
          }
        }
      }
    },
    "invocation.help.credentials": {
      "comment": "Native launch presentation. Preserve technical names and format placeholders; arguments are literal command syntax or display values.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legacy password files apply only to password-only authentication. %@ (with %@ when required) takes precedence.\nLaunch credentials belong to the first connection window (first accepted incoming window with %@) and are never saved.\nStopping the listener clears unclaimed launch credentials.\n"
          }
        }
      }
    },
    "invocation.help.adapters": {
      "comment": "Native launch presentation. Preserve technical names and format placeholders; arguments are literal command syntax or display values.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported native adapters fail explicitly; their parameters are never ignored.\n"
          }
        }
      }
    },
    "invocation.help.ssh": {
      "comment": "Native launch presentation. Preserve technical names and format placeholders; arguments are literal command syntax or display values.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH %@ accepts %@ or %@. It uses SSH host-key verification, default-key/agent authentication and native password/passphrase prompts.\nNew Ed25519/RSA/ECDSA gateway keys require explicit %@; changed keys are rejected.\nSupported %@ settings are captured before connecting; commands, proxy hops and %@ are unsupported.\nSSH forwarding cannot be used with %@ or Unix socket targets. An empty %@ value selects a direct connection.\n"
          }
        }
      }
    },
    "presentation.issue.startupUnavailable": {
      "comment": "Structured native presentation recovery. Do not insert arbitrary error descriptions, paths or remote payloads.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyVNC could not start the native viewer. Reopen the app. If the problem persists, install a compatible build of TidyVNC."
          }
        }
      }
    },
    "presentation.issue.startupIncompatible": {
      "comment": "Structured native presentation recovery. Do not insert arbitrary error descriptions, paths or remote payloads.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The native viewer components are incompatible or lack a required feature. Install a matching build of TidyVNC."
          }
        }
      }
    },
    "presentation.issue.startupResources": {
      "comment": "Structured native presentation recovery. Do not insert arbitrary error descriptions, paths or remote payloads.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TidyVNC could not allocate resources to start. Close unused applications and reopen TidyVNC."
          }
        }
      }
    },
    "presentation.issue.preferencesUnavailable": {
      "comment": "Structured native presentation recovery. Do not insert arbitrary error descriptions, paths or remote payloads.",
