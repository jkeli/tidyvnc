    "presentation.issue.desktopUnavailable": {
      "comment": "Structured native presentation recovery. Do not insert arbitrary error descriptions, paths or remote payloads.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote desktop could not be drawn. Try Refresh Desktop. If it still does not update, reconnect."
          }
        }
      }
    },
    "presentation.issue.desktopResources": {
      "comment": "Structured native presentation recovery. Do not insert arbitrary error descriptions, paths or remote payloads.",
