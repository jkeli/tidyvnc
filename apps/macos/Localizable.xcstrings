    "help.privacy": {
      "comment": "Native Help interface. Preserve literal endpoint syntax, paths and product names in guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before posting an issue, remove server addresses, usernames, credentials and other private information from screenshots or diagnostics."
          }
        }
      }
    },
    "help.guide.connect.title": {
      "comment": "Native Help interface. Preserve literal endpoint syntax, paths and product names in guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to a desktop"
          }
        }
      }
    },
    "help.guide.connect.body": {
      "comment": "Native Help interface. Preserve literal endpoint syntax, paths and product names in guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a server address, then select Connect. Use host:display (for example, localhost:1), host::port (localhost::5901), or [IPv6]:display. A Unix socket path is also accepted. Obtain the address and credentials from the server administrator."
          }
        }
      }
    },
    "help.guide.ssh.title": {
      "comment": "Native Help interface. Preserve literal endpoint syntax, paths and product names in guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH gateways"
          }
        }
      }
    },
    "help.guide.ssh.body": {
      "comment": "Native Help interface. Preserve literal endpoint syntax, paths and product names in guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave SSH gateway empty for a direct connection. For a tunnel, enter user@host or ssh://user@host:port. An omitted user or port may come from supported ~/.ssh/config settings. Commands and proxy hops are unavailable. SSH forwarding requires a TCP server address and cannot be combined with listening for incoming connections."
          }
        }
      }
    },
    "help.guide.identity.title": {
      "comment": "Native Help interface. Preserve literal endpoint syntax, paths and product names in guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify server identity"
          }
        }
      }
    },
    "help.guide.identity.body": {
      "comment": "Native Help interface. Preserve literal endpoint syntax, paths and product names in guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare a new server or gateway fingerprint with the administrator before approving it. SSH gateway verification and the VNC server’s identity are separate decisions. Changed SSH gateway keys are rejected. SSH passwords and passphrases are used once; a failed gateway-key save prevents the VNC connection from starting."
          }
        }
      }
    },
    "help.guide.profiles.title": {
      "comment": "Native Help interface. Preserve literal endpoint syntax, paths and product names in guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiles, files and defaults"
          }
        }
      }
    },
    "help.guide.profiles.body": {
      "comment": "Native Help interface. Preserve literal endpoint syntax, paths and product names in guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved Profiles stores named addresses and connection settings. Open Connection creates a window; select Connect when ready. Settings supplies defaults for new windows, while connection settings apply to that window. Connection files are reviewed before use. Passwords are not exported with profiles or files."
          }
        }
      }
    },
    "help.guide.input.title": {
      "comment": "Native Help interface. Preserve literal endpoint syntax, paths and product names in guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control and clipboard"
          }
        }
      }
    },
    "help.guide.input.body": {
      "comment": "Native Help interface. Preserve literal endpoint syntax, paths and product names in guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the remote desktop to direct keyboard and pointer input to it. View-only mode blocks remote input. The clipboard menu has independent Send and Receive controls. Input, Scaling and Encoding controls are available for a connected desktop; the Connection menu provides additional settings and desktop commands."
          }
        }
      }
    },
    "help.guide.listen.title": {
      "comment": "Native Help interface. Preserve literal endpoint syntax, paths and product names in guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incoming connections"
          }
        }
      }
    },
    "help.guide.listen.body": {
      "comment": "Native Help interface. Preserve literal endpoint syntax, paths and product names in guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File → Listen for Connections opens a listener. Give the server this Mac’s network address and the displayed listening port, then accept or reject the incoming request. Closing the listener stops waiting for new connections."
          }
        }
      }
    },
    "help.guide.failure.title": {
      "comment": "Native Help interface. Preserve literal endpoint syntax, paths and product names in guidance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a connection fails"
          }
        }
      }
