<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleDisplayName</key>
	<string>TidyVNC</string>
	<key>CFBundleExecutable</key>
	<string>vncviewer</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>CFBundleGetInfoString</key>
	<string>@VERSION@, Copyright (C) 1999-2026 TigerVNC team and many others (see README.rst)</string>
	<key>CFBundleIconFile</key>
	<string>tidyvnc.icns</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.jkeli.tidyvnc</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLongVersionString</key>
	<string>TidyVNC @VERSION@</string>
	<key>CFBundleName</key>
	<string>TidyVNC</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@f@BUILD@</string>
	<key>LSRequiresCarbon</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright (C) 1999-2026 TigerVNC team and many others (see README.rst)</string>
	<key>CFBundleDocumentTypes</key>
	<array><dict>
		<key>CFBundleTypeName</key><string>TidyVNC connection</string>
		<key>CFBundleTypeRole</key><string>Viewer</string>
		<key>LSHandlerRank</key><string>Owner</string>
		<key>CFBundleTypeExtensions</key><array><string>tidyvnc</string></array>
	</dict></array>
</dict>
</plist>
