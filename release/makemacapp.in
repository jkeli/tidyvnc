#!/bin/sh
# Stage and package the same viewer, catalogs and reviewed icon.
set -eu
PACKAGE_NAME=TidyVNC
VERSION='@VERSION@'
SRCDIR='@CMAKE_SOURCE_DIR@'
BINDIR='@CMAKE_BINARY_DIR@'
STAGING=$(mktemp -d "$BINDIR/release/tidyvnc-stage.XXXXXX")
trap 'rm -rf "$STAGING"' EXIT
trap 'exit 1' INT TERM
APPROOT="$STAGING/dmg/$PACKAGE_NAME.app"
mkdir -p "$APPROOT/Contents/MacOS" "$APPROOT/Contents/Resources"
install -m 755 "$BINDIR/vncviewer/vncviewer" "$APPROOT/Contents/MacOS/"
install -m 644 "$SRCDIR/media/icons/tidyvnc.icns" "$APPROOT/Contents/Resources/"
install -m 644 "$BINDIR/release/Info.plist" "$APPROOT/Contents/"
for lang in @MACAPP_LANGUAGES@; do
  mkdir -p "$APPROOT/Contents/Resources/locale/$lang/LC_MESSAGES"
  install -m 644 "$BINDIR/po/$lang.mo" \
    "$APPROOT/Contents/Resources/locale/$lang/LC_MESSAGES/tidyvnc.mo"
done
# Sign only after all bundle resources are present. No sandbox/network bypass
# entitlement: macOS still asks the user for Local Network access.
SIGN_IDENTITY='@MACAPP_SIGN_IDENTITY_SHELL@'
codesign --force --sign "$SIGN_IDENTITY" --identifier io.github.jkeli.tidyvnc \
  --timestamp=none "$APPROOT"
codesign --verify --strict "$APPROOT"
install -m 644 "$SRCDIR/LICENCE.TXT" "$SRCDIR/README.rst" "$STAGING/dmg/"
# Keep a persistent app for inspection and loopback tests.
FINALAPP="$BINDIR/$PACKAGE_NAME.app"
if [ -L "$FINALAPP" ]; then
  echo "Refusing to replace a symlink at $FINALAPP" >&2
  exit 1
fi
rm -rf "$FINALAPP"
ditto "$APPROOT" "$FINALAPP"
if [ "${1:-}" = '--stage-only' ]; then exit 0; fi
hdiutil create -fs HFS+ -volname "$PACKAGE_NAME-$VERSION" \
  -srcfolder "$STAGING/dmg" "$STAGING/$PACKAGE_NAME-$VERSION.dmg"
mv -f "$STAGING/$PACKAGE_NAME-$VERSION.dmg" "$BINDIR/release/$PACKAGE_NAME-$VERSION.dmg"
